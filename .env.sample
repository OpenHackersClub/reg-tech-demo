# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=reg-tech-demo

# S3/MinIO Configuration
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Application Configuration
NODE_ENV=development
PORT=3000

# Confluent Cloud Configuration
CONFLUENT_CLOUD_API_KEY=your-confluent-cloud-api-key
CONFLUENT_CLOUD_API_SECRET=your-confluent-cloud-api-secret

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-west-2.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=your-kafka-api-key
KAFKA_SASL_PASSWORD=your-kafka-api-secret
KAFKA_SASL_MECHANISM=plain
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_GROUP_ID=reg-tech-demo-consumer-group

# Flink Configuration
FLINK_COMPUTE_POOL_ID=your-flink-compute-pool-id
FLINK_API_KEY=your-flink-api-key
FLINK_API_SECRET=your-flink-api-secret

# Pulumi Configuration
PULUMI_ACCESS_TOKEN=your-pulumi-access-token
PULUMI_CONFIG_PASSPHRASE=your-pulumi-config-passphrase
