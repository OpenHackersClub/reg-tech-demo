{
  "name": "@reg-tech-demo/txn-service",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "ingest:transactions": "tsdown src/workers/transaction-ingestion.worker.ts && node dist/transaction-ingestion.worker.mjs",
    "aml:detect": "tsdown src/workers/aml-detection.worker.ts",
    "lint": "biome lint .",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsdown src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.501.0",
    "@confluentinc/kafka-javascript": "^1.3.0",
    "@effect/platform-node": "^0.53.7",
    "@reg-tech-demo/transaction-fixtures": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.29.3",
    "effect": "^3.18.4",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.20.9",
    "tsdown": "^0.15.12",
    "typescript": "^5"
  }
}
